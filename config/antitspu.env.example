# Скопируйте в /etc/3x-ui-antitspu.env и отредактируйте.
# install.sh и scripts/apply.sh читают этот файл.

# Куда клонировать репозиторий (по умолчанию /opt/3x-ui-antitspu)
# ANTITSPU_DIR=/opt/3x-ui-antitspu

# Домен для WS/gRPC в подписке (опционально). Пусто = только IP.
# LINK_DOMAIN=stats.example.com
# LINK_DOMAIN_SUBS=*

# Self-steal REALITY: домен с валидным TLS на nginx (шаблон zz-selfsteal)
# SELFSTEAL_DOMAIN=stats.example.com
# SELFSTEAL_LISTEN_PORT=10448

# Обновить Xray-core панели до версии (опционально, например 26.7.28)
# XRAY_VERSION=26.7.28

# Не ставить базовый стек с нуля (только overlay на уже установленную панель)
# SKIP_BASE_INSTALL=1
