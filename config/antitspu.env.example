# Скопируйте в /etc/3x-ui-antitspu.env. install.sh спросит домен/IP и NODE_REMARK;
# LINK_DOMAIN и self-steal выставляются сами (прод poland не переспрашиваем).

# ANTITSPU_DIR=/opt/3x-ui-antitspu

# IP/хост в ссылках подписки
# PUBLIC_HOST=45.82.64.50

# Имя узла на все inbound (как poland на проде). apply всегда выравнивает remark.
# NODE_REMARK=hetherlands
# NODE_REMARK_STYLE=unified   # unified (по умолчанию) | suffix | kit

# Домен для WS/gRPC в подписке
# LINK_DOMAIN=stats.example.com
# LINK_DOMAIN_SUBS='*'

# Self-steal REALITY (nginx zz-selfsteal)
# SELFSTEAL_DOMAIN=stats.example.com
# SELFSTEAL_LISTEN_PORT=10448

# XRAY_VERSION=26.7.28

# SKIP_BASE_INSTALL=1

# INSTALLER_EXTRA_ARGS=--port 8443
