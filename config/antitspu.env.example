# Скопируйте в /etc/3x-ui-antitspu.env или: scripts/configure-prompt.sh

# ANTITSPU_DIR=/opt/3x-ui-antitspu

# IP/хост в ссылках подписки
# PUBLIC_HOST=45.82.64.50

# Имя узла: remark вида «NL-02 · REALITY», «NL-02 · XHTTP» (не одно имя на все!)
# NODE_REMARK=NL-02

# Домен для WS/gRPC в подписке
# LINK_DOMAIN=stats.example.com
# LINK_DOMAIN_SUBS=*

# Self-steal REALITY (nginx zz-selfsteal)
# SELFSTEAL_DOMAIN=stats.example.com
# SELFSTEAL_LISTEN_PORT=10448

# XRAY_VERSION=26.7.28

# SKIP_BASE_INSTALL=1

# INSTALLER_EXTRA_ARGS=--port 8443
